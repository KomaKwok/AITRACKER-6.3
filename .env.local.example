DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
CRON_SECRET=replace-with-a-long-random-secret

# Durable refreshed data on Vercel (recommended). Create a private Blob store
# connected to the project; Vercel injects this value automatically.
BLOB_READ_WRITE_TOKEN=

# Alternative for hosts with a mounted persistent disk. On Render, mount the disk
# at /opt/render/project/src/data and set this variable to the same absolute path.
RADAR_DATA_DIR=
